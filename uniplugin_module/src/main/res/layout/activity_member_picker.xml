<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F7"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/mpBack"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#111111"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/mpTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="选择成员"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mpConfirm"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="确定"
            android:textColor="#FA5151"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 搜索栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingTop="0dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/mpSearch"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_mp_search"
            android:drawableStart="@drawable/ic_member_picker_search"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:hint="搜索昵称/备注"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="#2A2A2A"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mpList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/mpEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无人选"
                android:textColor="#999999"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/mpProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

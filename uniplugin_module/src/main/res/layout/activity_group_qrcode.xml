<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F8"
    android:orientation="vertical">

    <!-- 导航栏（白）：返回箭头 + 居中标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/gqBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="返回"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="群二维码"
            android:textColor="#111111"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- 卡片一：头像 + 名称 + 二维码 + 提示 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_group_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/gqLogo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_member_card"
                    android:contentDescription="群头像" />

                <TextView
                    android:id="@+id/gqName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text=""
                    android:textColor="#111111"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/gqQr"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="20dp"
                    android:contentDescription="群二维码" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="扫一扫，加入群聊"
                    android:textColor="#999999"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 卡片二：群ID + 复制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_group_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="群ID"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/gqIdValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/gqCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_chip_purple"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="复制"
                    android:textColor="#9079F9"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 保存到相册 -->
            <TextView
                android:id="@+id/gqSave"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_picker_confirm"
                android:gravity="center"
                android:text="保存到相册"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  红包沉浸式弹窗（Figma 5339:6499 / 5339:6616）
  逐项读数（750×1624 帧，@2x → dp）：
  · 遮罩 750×1624 #000000 op=0.5
  · 卡片 578×956 → 289×478dp，底 #D63C1E r=24px→12dp
  · 上半区 578×769 → 289×384dp，#EE4D2C，顶部圆角 12dp
  · 发件人行 y 偏移 210px→105dp；头像 44px→22dp r8px→4dp；名字 36px→18sp #FFF4E9
  · 祝福语 y 偏移 284px→142dp；40px→20sp #FFF4E9
  · 開按钮 184px→92dp 圆，#E9CB9A + 1px #AC4126；y 偏移 667px→333dp（跨上下区交界）
  · 「领取记录」28px→14sp #FFF4E9，距卡顶 893px→446dp；右箭头 24×40px
  · 关闭 88px→44dp 圆 #000000@5% + X（#FFF4E9），距卡片 32px→16dp
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/rpCard"
            android:layout_width="289dp"
            android:layout_height="478dp"
            android:background="@drawable/zimkit_shape_red_packet_modal">

            <!-- 上半区 #EE4D2C（384dp，顶部圆角 12dp） -->
            <LinearLayout
                android:id="@+id/rpTopArea"
                android:layout_width="match_parent"
                android:layout_height="384dp"
                android:background="@drawable/zimkit_shape_red_packet_modal_top"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="105dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/rpSenderAvatar"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="头像" />

                    <TextView
                        android:id="@+id/rpSenderName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="#FFF4E9"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rpRemark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="恭喜发财，大吉大利"
                    android:textColor="#FFF4E9"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- 開按钮：92dp 圆形金币，位于卡顶 333dp（跨上下区交界，Figma 设计如此） -->
            <FrameLayout
                android:id="@+id/rpOpenBtn"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="333dp"
                android:background="@drawable/zimkit_shape_coin_button"
                android:clickable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:includeFontPadding="false"
                    android:text="開"
                    android:textColor="#111111"
                    android:textSize="26sp" />
            </FrameLayout>

            <!-- 已领取金额 / 状态文案 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="94dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rpAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#FFF4E9"
                    android:textSize="24sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/rpStateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#FFF4E9"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 下半区：领取记录（Figma 距卡顶 446dp，行高 93.5dp） -->
            <LinearLayout
                android:id="@+id/rpRecordsRow"
                android:layout_width="match_parent"
                android:layout_height="93dp"
                android:layout_gravity="bottom"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="领取记录"
                    android:textColor="#FFF4E9"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="查看"
                    android:src="@drawable/zimkit_ic_chevron_right_cream" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/rpCloseBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/zimkit_shape_close_circle"
            android:clickable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="关闭"
                android:src="@drawable/zimkit_ic_close_cream" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>

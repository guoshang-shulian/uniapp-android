<?xml version="1.0" encoding="utf-8"?>
<!--
  红包弹窗（Figma 5339:6499 / 5339:6616，750×1624 稿 @2x → dp）
  · 遮罩 750×1624 #000000 op=0.5（含状态栏区域：窗口走 LAYOUT_FULLSCREEN）
  · 卡片 578×956 → 289×478dp，底 #D63C1E r24px→12dp，内阴影 inset 0 0 4 #000@20%
  · 上半区 578×769 → 289×384.5dp #EE4D2C（矢量，底边弧形 —— 见 ic_red_packet_modal_top）
  · 開 铜钱 184×184 → 92dp 圆 #E9CB9A + 1px #AC4126 内描边；開字矢量 62×65 → 30.5×32.5dp #111111
  · 关闭 88×88 → 44dp 圆 #000000@5% + 米白 ✕
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      状态栏遮罩补丁：Dialog 的窗口在某些 ROM 上仍被限制在状态栏之下
      （实测 decor bounds=[0,147]...），窗口本身够不到状态栏，
      所以在内容最顶层补一条与遮罩同色的色带，高度由代码按真实状态栏高度设置。
    -->
    <View
        android:id="@+id/rpStatusBarMask"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="#80000000" />

    <!-- 遮罩层：铺满整屏的半透明黑。既负责"变暗"，也负责"点空白处关闭弹窗"
         （全屏 Activity 方案下，遮罩能真正盖住状态栏，所以 rpStatusBarMask 高度恒为 0） -->
    <FrameLayout
        android:id="@+id/rpMaskLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/rpCard"
            android:layout_width="289dp"
            android:layout_height="478dp"
            android:background="@drawable/zimkit_shape_red_packet_modal">

            <!-- 上半区：矢量弧形（Figma 5339:6593 原样），弧形向下盖住卡片中部。
                 高度 769px→385.5dp（图 578×769 的比例必须与「上半区/卡片」= 769/956 一致，
                 否则弧形接缝相对卡片中点会偏移） -->
            <ImageView
                android:id="@+id/rpTopArea"
                android:layout_width="289dp"
                android:layout_height="385.5dp"
                android:layout_gravity="top|start"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/ic_red_packet_modal_top" />

            <!-- 内阴影（inset 0 0 4 #000@20%）：左右各 1dp 竖渐变 + 顶部微暗 -->
            <View
                android:layout_width="2dp"
                android:layout_height="385.5dp"
                android:layout_gravity="top|start"
                android:background="@drawable/zimkit_shape_modal_inner_shadow_left" />

            <View
                android:layout_width="2dp"
                android:layout_height="385.5dp"
                android:layout_gravity="top|end"
                android:background="@drawable/zimkit_shape_modal_inner_shadow_right" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="105dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/rpSenderAvatar"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="头像" />

                <TextView
                    android:id="@+id/rpSenderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#FFF4E9"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/rpRemark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="142dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="恭喜发财，大吉大利"
                android:textColor="#FFF4E9"
                android:textSize="20sp" />

            <!-- 開 铜钱：92dp 圆，卡顶 333dp（跨上下区交界，Figma 原样）；
                 旋转动画作用在铜钱本身（rpCoinRotator），不影响其他元素 -->
            <FrameLayout
                android:id="@+id/rpOpenBtn"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="333dp"
                android:clickable="true">

                <FrameLayout
                    android:id="@+id/rpCoinRotator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/zimkit_shape_coin_button">

                    <ImageView
                        android:layout_width="30.5dp"
                        android:layout_height="32.5dp"
                        android:layout_gravity="center"
                        android:contentDescription="開"
                        android:src="@drawable/ic_red_packet_kai" />
                </FrameLayout>
            </FrameLayout>

            <!-- 已领取金额 / 状态文案 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="94dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rpAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#FFF4E9"
                    android:textSize="24sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/rpStateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#FFF4E9"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 下半区：领取记录（Figma 5339:6597/6598：文字+箭头距卡顶 893px→446.5dp，行高 93.5px→46.75dp）
                 原稿该行会溢出卡片底边 15dp（被卡片裁掉），所以这里对齐到卡片底部、行高取可见部分的 46.75dp，
                 文字中心正好落在 446.5dp + 23.4dp ≈ 470dp —— 和设计稿的 466.5dp 一致（差 3.5dp 内）。
                 注意：不要用 ?selectableItemBackground（MIUI 强制主题时会 inflate 崩溃），
                 水波纹由 RedPacketOpenDialog 代码里安全设置。 -->
            <LinearLayout
                android:id="@+id/rpRecordsRow"
                android:layout_width="match_parent"
                android:layout_height="46.75dp"
                android:layout_gravity="bottom"
                android:clickable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="领取记录"
                    android:textColor="#FFF4E9"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="查看"
                    android:src="@drawable/zimkit_ic_chevron_right_cream" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/rpCloseBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/zimkit_shape_close_circle"
            android:clickable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="关闭"
                android:src="@drawable/zimkit_ic_close_cream" />
        </FrameLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>

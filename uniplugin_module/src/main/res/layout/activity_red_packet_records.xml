<?xml version="1.0" encoding="utf-8"?>
<!-- 红包领取记录（Figma 5339:6845 未领取记录 / 5339:6862 专属红包领取记录） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF3F9"
    android:orientation="vertical">

    <!-- 顶部红色区（Figma 750×500 → 375×250dp，顶部圆角 12dp） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@drawable/bg_red_header"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rrBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="返回"
                android:padding="11dp"
                android:src="@drawable/ic_back_arrow_white" />

            <TextView
                android:id="@+id/rrTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <View
                android:layout_width="44dp"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>

    <!-- 内容区：红区下 40dp 起（Figma：发件人行 y 偏移 80px→40dp） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="40dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rrSenderAvatar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="头像" />

            <TextView
                android:id="@+id/rrSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text=""
                android:textColor="#111111"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/rrRemark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.4"
            android:text="恭喜发财，大吉大利"
            android:textColor="#999999"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/rrSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="12dp"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.4"
            android:text=""
            android:textColor="#999999"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="8dp"
            android:background="#0D000000" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/rrList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>

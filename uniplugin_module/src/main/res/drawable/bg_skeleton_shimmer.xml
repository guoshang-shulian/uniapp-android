<?xml version="1.0" encoding="utf-8"?>
<!--
  骨架屏流光：浅灰底（#ECECF2）+ 一条更亮的高光带（#F8F8FB）从左向右无限扫过。
  用 <animated-vector> 不可行（这是纯色块不是矢量路径），
  用 <animation-list> 逐帧也只会在整块上闪，看不出"流动"。
  正确做法：把三色渐变当背景，再用 <objectAnimator> 平移它的 centerX（见 MemberInfoActivity.startShimmer）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <gradient
        android:angle="0"
        android:centerColor="#F8F8FB"
        android:centerX="0.15"
        android:endColor="#ECECF2"
        android:startColor="#ECECF2"
        android:type="linear" />
</shape>

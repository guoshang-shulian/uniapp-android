<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      tools:context=".ZIMKitMessageActivity">

    <!-- 1. The original TitleBar -->
    <com.zegocloud.zimkit.common.components.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. INSERTED: Group Notification Banner -->

    <LinearLayout
        android:id="@+id/layout_group_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3CD"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/title_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

      <TextView
          android:id="@+id/tv_group_notice_content"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="本群在会议中"
          android:textColor="@android:color/black"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/tv_group_notice_enter"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:clickable="true"
          android:focusable="true"
          android:text="进入"
          android:textColor="#1677FF"
          android:textSize="14sp"
          android:textStyle="bold"
          android:paddingStart="12dp"
          android:paddingEnd="4dp" />

    </LinearLayout>


    <androidx.cardview.widget.CardView
        android:id="@+id/product_preview_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:visibility="visible"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/title_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="8dp">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/product_image"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            android:src="@drawable/zimkit_icon_empty_dracula" />

        <!-- "X" Close Button (Placed in the top right corner) -->
        <ImageView
            android:id="@+id/btn_close_product_card"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close product view"
            app:tint="#8E9093" />

        <!-- Send Action Button (Shifted down, below the close icon) -->
        <Button
            android:id="@+id/btn_send_product"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/btn_close_product_card"
            android:layout_marginTop="4dp"
            android:backgroundTint="#1890FF"
            android:text="SEND"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:padding="0dp"/>

        <!-- Product Text Details Layout (Constrained cleanly between image and action items) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/product_image"
            android:layout_toStartOf="@id/btn_send_product"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:layout_centerVertical="true">

          <TextView
              android:id="@+id/product_title"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Demo Shop Product Name"
              android:textColor="#2A2A2A"
              android:textSize="14sp"
              android:textStyle="bold"
              android:maxLines="1"
              android:ellipsize="end"/>

          <TextView
              android:id="@+id/product_price"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:text="ZK 250.00"
              android:textColor="#FF4D4F"
              android:textStyle="bold"
              android:textSize="15sp" />
        </LinearLayout>

      </RelativeLayout>
    </androidx.cardview.widget.CardView>




    <!-- 3. UPDATED: FrameLayout now anchors to the bottom of layout_group_notice -->
    <FrameLayout
        android:id="@+id/fra_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_group_notice" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>

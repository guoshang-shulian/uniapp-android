<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.zegocloud.zimkit.common.components.widget.TitleBar
      android:id="@+id/title_bar"
      android:layout_width="match_parent"
      android:layout_height="@dimen/title_bar_height"
      app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/content"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:background="@color/color_eff0f2"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/title_bar"
      app:layout_constraintVertical_bias="0.0"
      tools:layout_editor_absoluteX="0dp">

      <!-- 对方 + 邀请占位：与群聊「群聊成员」行**完全同一套排布**
           （icon 34dp + 下方 12sp 名字；占位 = zimkit_icon_member_add + 下方「邀请」）——
           私聊只需要「邀请」占位，**不要「踢出」**。
           宿主（uniplugin）未注册动作桥时，整个「邀请」占位会被代码隐藏，避免"点了没反应" -->
      <LinearLayout
        android:id="@+id/contact_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/zimkit_shape_8dp_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="center_horizontal"
          android:orientation="vertical">

          <ImageView
            android:id="@+id/contact_icon"
            android:layout_width="34dp"
            android:layout_height="34dp" />

          <TextView
            android:id="@+id/contact_name"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/color_646A73"
            android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
          android:id="@+id/contact_add"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="20dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center_horizontal"
          android:orientation="vertical">

          <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/invite"
            android:src="@drawable/zimkit_icon_member_add" />

          <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/invite"
            android:textColor="@color/color_646A73"
            android:textSize="12sp" />
        </LinearLayout>
      </LinearLayout>

      <LinearLayout
        android:id="@+id/chat_setting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/zimkit_shape_8dp_white"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/contact_info">

        <com.zegocloud.zimkit.components.message.ui.AsynchronousSwitch
          android:id="@+id/do_not_disturb"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:background="?selectableItemBackground"
          android:gravity="center_vertical"
          android:paddingStart="15dp"
          android:textColor="@color/color_2a2a2a"
          android:paddingEnd="9dp"
          android:text="@string/do_not_disturb"
          android:textSize="15sp" />

        <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginStart="16dp"
          android:background="@color/color_e6e6e6" />

        <com.zegocloud.zimkit.components.message.ui.AsynchronousSwitch
          android:id="@+id/pin_chat"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:layout_marginTop="1dp"
          android:textColor="@color/color_2a2a2a"
          android:background="?selectableItemBackground"
          android:gravity="center_vertical"
          android:paddingStart="15dp"
          android:paddingEnd="9dp"
          android:text="@string/chat_pin"
          android:textSize="15sp" />
      </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
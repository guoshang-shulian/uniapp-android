<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="view"
      type="android.view.View" />

    <variable
      name="model"
      type="com.zegocloud.zimkit.components.message.model.ZIMKitMessageModel" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    tools:background="@color/color_eff0f2">

    <androidx.appcompat.widget.AppCompatCheckBox
      android:id="@+id/select_checkbox"
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:layout_marginLeft="8dp"
      android:layout_marginRight="8dp"
      android:button="@drawable/zimkit_selector_checkbox"
      android:checked="@{model.isCheck}"
      android:clickable="false"
      app:layout_constraintBottom_toBottomOf="@id/iv_avatar"
      app:layout_constraintLeft_toLeftOf="parent"
      app:layout_constraintTop_toTopOf="@id/iv_avatar" />

    <ImageView
      android:id="@+id/iv_avatar"
      android:layout_width="42dp"
      android:layout_height="42dp"
      android:layout_marginStart="12dp"
      android:layout_marginEnd="8dp"
      app:avatarMessageUrl="@{model.avatar}"
      app:layout_constraintEnd_toStartOf="@id/item_status_message_layout"
      app:layout_constraintStart_toEndOf="@+id/select_checkbox"
      app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
      android:id="@+id/item_status_message_layout"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginEnd="63dp"
      android:orientation="vertical"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@id/iv_avatar"
      app:layout_constraintTop_toTopOf="@id/iv_avatar">

      <TextView
        android:id="@+id/tv_nick_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:includeFontPadding="false"
        android:text="@{model.nickName}"
        android:textColor="@color/color_666666"
        android:textSize="12sp"
        android:visibility="@{model.nickName.empty?view.GONE:view.VISIBLE}"
        tools:text="aaa"
        tools:visibility="visible" />

<LinearLayout
        android:id="@+id/item_message_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/zimkit_shape_8dp_white_card"
        android:clickable="true"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
          android:id="@+id/item_message_reply_layout"
          android:layout_width="match_parent"
          android:layout_height="22dp"
          android:orientation="horizontal"
          android:visibility="gone" />

        <!--
          红包卡（Figma 5339:6257，750 稿 @2x → dp）
          · 内容行（封面 + 文案）与卡底行（分隔线 + 「积分红包」）上下堆叠 —— 自然布局，不再用绝对定位硬撑
          · 封套 76×90 → 38×45dp；文案与封套同一行 gravity=center_vertical（代码再按封套中心对齐）
          · 分隔线 448×1 → 224×0.5dp 白 30%；「积分红包」20px → 10sp 白
          · 已被领完整卡 op=0.5（代码设置）
        -->
        <FrameLayout
          android:id="@+id/item_card_layout"
          android:layout_width="248dp"
          android:layout_height="wrap_content"
          android:minHeight="92dp"
          android:paddingStart="8dp"
          android:paddingEnd="8dp"
          android:paddingTop="8dp"
          android:paddingBottom="6dp"
          android:visibility="gone">

          <LinearLayout
            android:id="@+id/rp_content_row"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
              android:id="@+id/card_icon"
              android:layout_width="38dp"
              android:layout_height="45dp"
              android:scaleType="fitCenter"
              android:src="@drawable/zimkit_ic_envelope_card" />

            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:id="@+id/card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                tools:text="恭喜发财，大吉大利" />

              <TextView
                android:id="@+id/card_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                tools:text="恭喜发财，大吉大利" />
            </LinearLayout>
          </LinearLayout>

          <LinearLayout
            android:id="@+id/rp_footer_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <!-- 顺序必须是「细线在上、文字在下」（Figma：线 y122px→61dp，文字 y131px→65.5dp） -->
            <View
              android:id="@+id/card_divider"
              android:layout_width="match_parent"
              android:layout_height="0.5dp"
              android:background="#4DFFFFFF" />

            <LinearLayout
              android:id="@+id/rp_footer_content"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:gravity="center_vertical"
              android:orientation="horizontal">

              <TextView
                android:id="@+id/card_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="积分红包"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

              <TextView
                android:id="@+id/card_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/color_86A3B8"
                android:textSize="11sp"
                tools:text="100积分" />
            </LinearLayout>
          </LinearLayout>
        </FrameLayout>

        <!-- 商品 / 店铺 / 文章卡：卡片主体（行内边距 8dp = Figma 16px→8dp，图标与文案不再各带外边距堆叠） -->
        <LinearLayout
          android:id="@+id/item_card_row"
          android:layout_width="248dp"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="8dp"
          android:visibility="gone">

          <ImageView
            android:id="@+id/card_icon_row"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/zimkit_shape_6dp_image_bg"
            android:scaleType="centerCrop"
            tools:src="@mipmap/zimkit_icon_group" />

          <LinearLayout
            android:id="@+id/card_text_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
              android:id="@+id/card_title_row"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:ellipsize="end"
              android:includeFontPadding="false"
              android:maxLines="2"
              android:textColor="@color/color_2a2a2a"
              android:textSize="14sp"
              tools:text="拼手气红包" />

            <TextView
              android:id="@+id/card_subtitle_row"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:ellipsize="end"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:textColor="@color/color_646A73"
              android:textSize="12sp"
              tools:text="店铺名" />

            <TextView
              android:id="@+id/card_desc_row"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:ellipsize="end"
              android:includeFontPadding="false"
              android:maxLines="2"
              android:textColor="@color/color_646A73"
              android:textSize="12sp"
              android:visibility="gone"
              tools:text="商品描述" />

            <LinearLayout
              android:id="@+id/card_chip_row"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:orientation="horizontal"
              android:visibility="gone">

              <TextView
                android:id="@+id/card_chip_1"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:background="@drawable/zimkit_shape_chip_gray"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="#999999"
                android:textSize="12sp"
                tools:text="已售 140" />

              <TextView
                android:id="@+id/card_chip_2"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/zimkit_shape_chip_gray"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="#999999"
                android:textSize="12sp"
                tools:text="库存 180" />
            </LinearLayout>

            <LinearLayout
              android:id="@+id/card_footer_row"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:orientation="horizontal">

              <TextView
                android:id="@+id/card_footer_row_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/color_646A73"
                android:textSize="11sp"
                tools:text="示例店铺" />

              <TextView
                android:id="@+id/card_status_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/color_86A3B8"
                android:textSize="11sp"
                tools:text="100积分" />
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>

        <!--
          社群邀请卡（上下两段布局）
          上段：左=社群头像(48dp)，右=两行文字（邀请语 14sp / 社群名称 12sp），整体居中对齐
          下段：紫色文字按钮「申请加入」独占一行、整行居中
        -->
        <LinearLayout
          android:id="@+id/item_card_invite"
          android:layout_width="248dp"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingLeft="12dp"
          android:paddingTop="12dp"
          android:paddingRight="12dp"
          android:paddingBottom="8dp"
          android:visibility="gone">

          <!-- 上段：左头像 + 右两行文字 -->
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
              android:id="@+id/card_invite_logo"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:background="@drawable/zimkit_shape_6dp_image_bg"
              android:scaleType="centerCrop"
              tools:src="@mipmap/zimkit_icon_group" />

            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="10dp"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:id="@+id/card_invite_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/color_2a2a2a"
                android:textSize="14sp"
                tools:text="邀请您加入社群" />

              <TextView
                android:id="@+id/card_invite_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/color_646A73"
                android:textSize="12sp"
                tools:text="某某社群" />
            </LinearLayout>
          </LinearLayout>

          <!-- 下段：紫色文字按钮，独占一行居中（样式不变） -->
          <TextView
            android:id="@+id/card_invite_join"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="申请加入"
            android:textColor="#9079F9"
            android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.flexbox.FlexboxLayout
          android:id="@+id/msg_reaction_layout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          app:applyReactions="@{model}"
          app:flexDirection="row"
          app:flexWrap="wrap"
          app:justifyContent="flex_start" />
      </LinearLayout>
    </LinearLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>

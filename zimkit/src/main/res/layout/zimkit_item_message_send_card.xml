<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="view"
      type="android.view.View" />

    <variable
      name="sentStatus"
      type="im.zego.zim.enums.ZIMMessageSentStatus" />

    <variable
      name="model"
      type="com.zegocloud.zimkit.components.message.model.ZIMKitMessageModel" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    tools:background="@color/color_eff0f2">

    <ImageView
      android:id="@+id/iv_avatar"
      android:layout_width="43dp"
      android:layout_height="43dp"
      android:layout_marginStart="8dp"
      android:layout_marginEnd="12dp"
      app:avatarMessageUrl="@{model.avatar}"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@id/item_status_message_layout"
      app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatCheckBox
      android:id="@+id/select_checkbox"
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:layout_marginLeft="8dp"
      android:layout_marginRight="8dp"
      android:button="@drawable/zimkit_selector_checkbox"
      android:checked="@{model.isCheck}"
      android:clickable="false"
      app:layout_constraintBottom_toBottomOf="@id/iv_avatar"
      app:layout_constraintLeft_toLeftOf="parent"
      app:layout_constraintTop_toTopOf="@id/iv_avatar" />

    <LinearLayout
      android:id="@+id/item_status_message_layout"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="63dp"
      android:gravity="end|center_vertical"
      android:orientation="horizontal"
      app:layout_constraintEnd_toStartOf="@id/iv_avatar"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@id/iv_avatar">

      <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:src="@mipmap/zimkit_icon_fail"
        android:visibility="@{model.sentStatus==sentStatus.FAILED?view.VISIBLE:view.GONE}" />

      <ProgressBar
        android:id="@+id/message_sending_pb"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="8dp"
        android:indeterminateTint="@color/color_ff3478fc"
        android:visibility="@{model.sentStatus==sentStatus.SENDING?view.VISIBLE:view.GONE}" />

      <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_message_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/zimkit_shape_8dp_white_card"
        android:clickable="true"
        android:elevation="2dp"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
          android:id="@+id/item_message_reply_layout"
          android:layout_width="match_parent"
          android:layout_height="22dp"
          android:orientation="horizontal"
          android:visibility="gone"
          app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
          android:id="@+id/item_card_layout"
          android:layout_width="240dp"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/item_message_reply_layout"
          app:layout_goneMarginTop="0dp">

          <ImageView
            android:id="@+id/card_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/zimkit_shape_6dp_image_bg"
            android:scaleType="centerCrop"
            tools:src="@mipmap/zimkit_icon_group" />

          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
              android:id="@+id/card_title"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:ellipsize="end"
              android:includeFontPadding="false"
              android:maxLines="2"
              android:textColor="@color/color_2a2a2a"
              android:textSize="14sp"
              tools:text="拼手气红包" />

            <TextView
              android:id="@+id/card_subtitle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:ellipsize="end"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:textColor="@color/color_646A73"
              android:textSize="12sp"
              tools:text="恭喜发财，大吉大利" />

            <TextView
              android:id="@+id/card_desc"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:ellipsize="end"
              android:includeFontPadding="false"
              android:maxLines="2"
              android:visibility="gone"
              android:textColor="@color/color_646A73"
              android:textSize="12sp"
              tools:text="商品描述" />

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="5dp"
              android:orientation="horizontal">

              <TextView
                android:id="@+id/card_footer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/color_646A73"
                android:textSize="11sp"
                tools:text="示例店铺" />

              <TextView
                android:id="@+id/card_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/color_86A3B8"
                android:textSize="11sp"
                tools:text="100积分" />
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>

        <com.google.android.flexbox.FlexboxLayout
          android:id="@+id/msg_reaction_layout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          app:applyReactions="@{model}"
          app:flexDirection="row"
          app:flexWrap="wrap"
          app:justifyContent="flex_start"
          app:layout_constraintTop_toBottomOf="@+id/item_card_layout" />
      </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
